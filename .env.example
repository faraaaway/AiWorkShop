# Copy this file to .env.local and fill in the path. .env.local is git-ignored.

# Absolute path of the Obscura v0.2.7 stealth build executable.
# Windows example: C:\tools\obscura\obscura.exe
# macOS example:   /Users/me/tools/obscura/obscura
OBSCURA_PATH=

# Automatic crawling while the app server (npm run dev / npm start) is running.
# Minutes between full crawls of all enabled sites. Default 60. Minimum 10. "0" or "off" disables it
# (then only the status-screen buttons and "npm run crawl" collect data).
# BF_AUTO_CRAWL_MINUTES=60
